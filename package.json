{
  "name": "flowpicker",
  "version": "0.0.0",
  "private": true,
  "description": "Tool picker for AI workflows.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test:all": "vitest run && playwright test",
    "serve": "http-server -p 8000 -c-1 .",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run serve\"",
    "build:pages": "node tools/build-static-pages.js",
    "build:sitemap": "node tools/build-sitemap.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
