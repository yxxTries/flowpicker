{
  "name": "flowpicker",
  "version": "0.0.0",
  "private": true,
  "description": "Tool picker for AI workflows.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test:all": "vitest run && playwright test",
    "serve": "http-server -p 8000 -c-1 .",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run serve\"",
    "build:pages": "node tools/build-static-pages.js",
    "build:compare": "node tools/build-compare-pages.js",
    "build:alternatives": "node tools/build-alternatives-pages.js",
    "build:best-for": "node tools/build-best-for-pages.js",
    "build:pricing": "node tools/build-pricing-pages.js",
    "build:agents": "node tools/build-agent-pages.js",
    "build:sitemap": "node tools/build-sitemap.js",
    "build:prune": "node scripts/prune-orphaned-pages.js",
    "build": "node tools/build-static-pages.js && node tools/build-compare-pages.js && node tools/build-alternatives-pages.js && node tools/build-best-for-pages.js && node tools/build-pricing-pages.js && node tools/build-agent-pages.js && node scripts/prune-orphaned-pages.js && node tools/build-sitemap.js",
    "data:normalize": "node scripts/normalize-llm-data.js",
    "data:update": "node scripts/apply-model-updates.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
